{
  "command": "sockstat -l -P tcp,udp",
  "facts": {
    "server.Kernel": "FreeBSD"
  },
  "output": [
    "USER     COMMAND    PID   FD PROTO  LOCAL ADDRESS         FOREIGN ADDRESS",
    "www      nginx      1234  3  tcp4   *:80                  *:*",
    "www      nginx      1234  4  tcp4   *:443                 *:*",
    "root     named      5678  20 udp4   *:53                  *:*"
