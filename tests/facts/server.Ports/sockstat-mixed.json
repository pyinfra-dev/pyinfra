  "fact": [
    {"protocol": "tcp", "port": 80, "address": "*", "process": "nginx", "pid": 1234},
    {"protocol": "tcp", "port": 443, "address": "*", "process": "nginx", "pid": 1234},
    {"protocol": "udp", "port": 53, "address": "*", "process": "named", "pid": 5678}
  ]
}
