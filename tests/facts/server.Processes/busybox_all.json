      "args": "/sbin/init"
    },
    "200": {
      "user": "root",
      "state": "S",
      "cpu_percent": 0.0,
      "mem_percent": 0.0,
      "command": "sshd",
      "args": "/usr/sbin/sshd"
    },
    "310": {
      "user": "root",
      "state": "S",
      "cpu_percent": 0.0,
      "mem_percent": 0.0,
      "command": "crond",
      "args": "/usr/sbin/crond -c /etc/crontabs"
    }
  }
