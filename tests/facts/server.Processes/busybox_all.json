{
  "command": "LANG=C ps -o pid,user,vsz,stat,args",
  "facts": {
    "server.Kernel": "Linux",
    "server.Which": {
      "command=busybox": "/bin/busybox"
    }
  },
  "output": [
    "  PID USER       VSZ STAT ARGS",
    "    1 root      2108 S    /sbin/init",
    "  200 root      1536 S    /usr/sbin/sshd",
    "  310 root      1488 S    /usr/sbin/crond -c /etc/crontabs"
  ],
  "fact": {
