{
    "kwargs": {
        "path": "/srv/app",
        "tags": "app:1.0",
        "network": "host",
        "cache_from": ["app:builder", "app:latest"],
        "secrets": ["id=npmrc,src=/root/.npmrc"]
    },
    "facts": {
        "docker.DockerImage": {
            "object_id=app:1.0": []
        }
    },
    "commands": [
        "docker build -t app:1.0 --network host --cache-from app:builder --cache-from app:latest --secret id=npmrc,src=/root/.npmrc /srv/app"
    ]
}
