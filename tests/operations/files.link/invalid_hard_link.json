{
    "args": ["testlink"],
    "kwargs": {
        "target": "/etc/init.d/nginx",
        "symbolic": false
    },
    "facts": {
        "files.Link": {
            "path=testlink": false
        },
        "files.File": {
            "path=testlink": {
                "user": "testuser",
                "group": "testgroup"
            }
        },
        "files.SameFile": {
            "path=testlink, target=/etc/init.d/nginx": false
        }
    },
    "exception": {
        "name": "OperationError",
        "message": "testlink exists and is not a link"
    }
}
