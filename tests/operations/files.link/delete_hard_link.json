{
    "args": ["testlink"],
    "kwargs": {
        "target": "/etc/init.d/nginx",
        "symbolic": false,
        "present": false
    },
    "facts": {
        "files.Link": {
            "path=testlink": false
        },
        "files.File": {
            "path=testlink": {
                "user": "testuser",
                "group": "testgroup"
            }
        },
        "files.SameFile": {
            "path=testlink, target=/etc/init.d/nginx": true
        }
    },
    "commands": [
        "rm -f testlink"
    ]
}
