{
    "kwargs": {
        "container": "nginx",
        "image": "nginx:alpine",
        "args": [
            "nginx-debug",
            "-g",
            "'daemon off;'"
        ],
        "ports": [
            "80:80"
        ],
        "present": true,
        "start": true
    },
    "facts": {
        "docker.DockerContainer": {
            "object_id=nginx": []
        }
    },
    "commands": [
        "docker container create --name nginx -p 80:80 nginx:alpine nginx-debug -g 'daemon off;'",
        "docker container start nginx"
    ]
}