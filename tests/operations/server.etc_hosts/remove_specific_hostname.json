{
    "args": ["192.168.1.10"],
    "kwargs": {
        "hostnames": "db",
        "present": false
    },
    "facts": {
        "server.EtcHosts": {
            "path=/etc/hosts": {
                "127.0.0.1": ["localhost"],
                "192.168.1.10": ["db.internal", "db"]
            }
        },
        "files.FileContents": {
            "path=/etc/hosts": [
                "127.0.0.1 localhost",
                "192.168.1.10 db.internal db"
            ]
        },
        "files.File": {
            "path=/etc/hosts": {}
        },
        "files.Directory": {
            "path=/etc": true,
            "path=/etc/hosts": false
        }
    },
    "commands": [
        ["upload", "127.0.0.1 localhost\n192.168.1.10 db.internal\n", "/etc/hosts"]
    ]
}
