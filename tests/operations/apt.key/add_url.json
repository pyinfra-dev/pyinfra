{
    "args": ["http://mykey"],
    "facts": {
        "files.Directory": {
            "path=/etc/apt/keyrings": null
        },
        "files.File": {
            "path=/etc/apt/keyrings/mykey-key.gpg": null,
            "path=_tempfile_": null
        },
        "server.Which": {
            "command=curl": "/usr/bin/curl"
        }
    },
    "commands": [
        "mkdir -p /etc/apt/keyrings",
        "chmod 755 /etc/apt/keyrings",
        "curl -sSLf http://mykey -o _tempfile_",
        "mv _tempfile_ _tempfile_",
        "if grep -q \"BEGIN PGP PUBLIC KEY BLOCK\" \"_tempfile_\"; then gpg --batch --dearmor -o \"/etc/apt/keyrings/mykey-key.gpg\" \"_tempfile_\"; else cp \"_tempfile_\" \"/etc/apt/keyrings/mykey-key.gpg\"; fi",
        "mkdir -p /etc/apt/keyrings",
        "touch /etc/apt/keyrings/mykey-key.gpg",
        "chmod 644 /etc/apt/keyrings/mykey-key.gpg"
    ]
}
