                        },
                        "DEF": {
                            "validity": "-",
                            "length": 4096,
                            "subkeys": {},
                            "fingerprint": "DEFDEF1234567890DEFDEF1234567890DEFDEF12",
                            "uid_hash": "DDDEEEFFF",
                            "uid": "Test Vendor B <b@vendor.com>"
                        }
                    }
                }
            }
        },
        "files.File": {
            "path=/etc/apt/keyrings/keyserver-abc-def.gpg": {"mode": 644, "user": "root", "group": "root"}
