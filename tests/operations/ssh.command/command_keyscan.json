{
    "args": ["remote-host.net", "echo hi"],
    "kwargs": {
        "user": "nick",
        "port": 33,
        "ssh_keyscan": true
    },
    "facts": {
        "server.Home": "/home/pyinfra",
        "files.Directory": {
            "path=/home/pyinfra/.ssh": {
                "mode": 700
            }
        },
        "files.FindInFile": {
            "extended_regex=False, interpolate_variables=False, path=/home/pyinfra/.ssh/known_hosts, pattern=remote-host.net": []
        }
    },
    "commands": [
        "ssh-keyscan -p 33 remote-host.net >> /home/pyinfra/.ssh/known_hosts",
        "ssh -p 33 nick@remote-host.net 'echo hi'"
    ],
    "idempotent": false
}
