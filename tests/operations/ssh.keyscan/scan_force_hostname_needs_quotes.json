{
    "args": ["evil;id"],
    "kwargs": {
        "force": true
    },
    "facts": {
        "server.Home": "/home/pyinfra",
        "files.Directory": {
            "path=/home/pyinfra/.ssh": {
                "mode": 700
            }
        },
        "files.FindInFile": {
            "extended_regex=False, interpolate_variables=False, path=/home/pyinfra/.ssh/known_hosts, pattern=evil;id": ["evil;id ssh-ed25519 AAAA"]
        }
    },
    "commands": [
        "ssh-keygen -R 'evil;id'",
        "ssh-keyscan -p 22 'evil;id' >> /home/pyinfra/.ssh/known_hosts"
    ],
    "idempotent": false,
    "disable_idempotent_warning_reason": "forced keyscans are always executed"
}
