{
    "args": [
        [
            "elasticquery==1.1",
            "flask",
            "test==1.1"
        ]
    ],
    "kwargs": {
        "virtualenv": "testdir"
    },
    "facts": {
        "pip.PipPackages": {
            "pip=testdir/bin/pip": {
                "elasticquery": [
                    "1.0"
                ],
                "test": [
                    "1.1"
                ]
            }
        },
        "files.File": {
            "path=testdir/bin/activate": true
        },
        "pip.PythonVersion": {
            "python=testdir/bin/python": [
                3,
                12,
                11
            ]
        }
    },
    "commands": [
        "testdir/bin/pip install elasticquery==1.1 flask"
    ]
}
