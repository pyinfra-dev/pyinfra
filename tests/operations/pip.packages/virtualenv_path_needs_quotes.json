{
    "kwargs": {
        "packages": [
            "flask"
        ],
        "virtualenv": "/opt/my venv"
    },
    "facts": {
        "files.File": {
            "path=/opt/my venv/bin/activate": true
        },
        "pip.PipPackages": {
            "pip='/opt/my venv'/bin/pip": {}
        },
        "pip.PythonVersion": {
            "python=/opt/my venv/bin/python": [
                3,
                12,
                11
            ]
        }
    },
    "commands": [
        "'/opt/my venv'/bin/pip install flask"
    ]
}
