{
    "args": ["someuser"],
    "facts": {
        "server.Users": {},
        "server.Groups": [
            "someuser"
        ],
        "files.Directory": {
            "path=/home/someuser": null
        },
        "server.Os": "Linux",
        "server.Which": {
            "command=useradd": "/usr/sbin/useradd"
        }
    },
    "commands": [
        "useradd -d /home/someuser -g someuser -M someuser",
        "mkdir -p /home/someuser",
        "chown someuser:someuser /home/someuser"
    ]
}
