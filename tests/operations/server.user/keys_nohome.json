{
    "args": ["root"],
    "kwargs": {
        "public_keys": ["abc"]
    },
    "facts": {
        "server.Os": "Linux",
        "server.Users": {
            "root": {
                "home": "/root",
                "group": "root",
                "groups": []
            }
        },
        "files.Directory": {
            "path=/root": {
                "user": "root",
                "group": "root"
            },
            "path=/root/.ssh": {
                "user": "root",
                "group": "root",
                "mode": 700
            }
        },
        "files.File": {
            "path=/root/.ssh/authorized_keys": {
                "user": "root",
                "group": "root",
                "mode": 601
            }
        },
        "files.FindInFile": {
            "extended_regex=False, interpolate_variables=False, path=/root/.ssh/authorized_keys, pattern=^.*abc.*$": []
        },
        "server.AuthorizedKeys": {
            "path=/root/.ssh/authorized_keys, user=root": []
        },
        "server.Groups": {},
        "server.Which": {
            "command=usermod": "/usr/sbin/usermod"
        }
    },
    "commands": [
        "chmod 600 /root/.ssh/authorized_keys",
        "( [ $(tail -c1 /root/.ssh/authorized_keys | wc -l) -eq 0 ] && echo ; echo abc ) >> /root/.ssh/authorized_keys"
    ]
}
