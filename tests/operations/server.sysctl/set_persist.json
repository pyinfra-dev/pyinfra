{
    "args": ["kern.max-files", 2000],
    "kwargs": {
        "persist": true
    },
    "facts": {
        "server.Sysctl": {
            "keys=['kern.max-files']": {}
        },
        "files.FindInFile": {
            "extended_regex=False, interpolate_variables=False, path=/etc/sysctl.conf, pattern=^.*kern.max-files[[:space:]]*=[[:space:]]*2000.*$": [],
            "extended_regex=False, interpolate_variables=False, path=/etc/sysctl.conf, pattern=^kern.max-files = 2000$": []
        }
    },
    "commands": [
        "sysctl kern.max-files=2000",
        "echo 'kern.max-files = 2000' >> /etc/sysctl.conf"
    ]
}
