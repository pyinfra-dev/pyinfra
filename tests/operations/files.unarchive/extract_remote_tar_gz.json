{
    "kwargs": {
        "src": "/tmp/app.tar.gz",
        "dest": "/opt/app",
        "remote_src": true
    },
    "facts": {
        "files.Directory": {
            "path=/opt/app": true
        },
        "files.File": {
            "path=/tmp/app.tar.gz": true
        }
    },
    "commands": [
        "tar -xz -f /tmp/app.tar.gz -C /opt/app"
    ]
}
