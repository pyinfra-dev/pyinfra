{
    "args": ["redis-server.service"],
    "kwargs": {
        "user_mode": false,
        "machine": "testmachine"
    },
    "facts": {
        "systemd.SystemdStatus": {
            "machine=testmachine, services=['redis-server.service'], user_mode=False, user_name=None": {
                "redis-server.service": false
            }
        }
    },
    "commands": [
        "systemctl --machine=testmachine start redis-server.service && systemctl --machine=testmachine is-active --quiet redis-server.service"
    ]
}
