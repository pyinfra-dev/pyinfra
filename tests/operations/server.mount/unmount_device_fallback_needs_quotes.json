{
    "args": ["/data"],
    "kwargs": {
        "device": "/dev/sdb1",
        "mounted": false
    },
    "facts": {
        "server.Mounts": {
            "/mnt/my data; rm -rf /": {
                "device": "/dev/sdb1",
                "type": "ext4",
                "options": ["rw", "relatime"]
            }
        }
    },
    "commands": [
        "umount '/mnt/my data; rm -rf /'"
    ]
}
