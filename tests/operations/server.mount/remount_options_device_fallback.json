{
    "args": ["/data"],
    "kwargs": {
        "device": "/dev/sdb1",
        "options": ["rw", "noatime"]
    },
    "facts": {
        "server.Kernel": "Linux",
        "server.Mounts": {
            "/mnt/data": {
                "device": "/dev/sdb1",
                "type": "ext4",
                "options": ["rw"]
            }
        }
    },
    "commands": [
        "mount -o remount,rw,noatime /mnt/data"
    ]
}
