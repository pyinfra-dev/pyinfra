{
    "args": ["/data"],
    "kwargs": {
        "device": "/dev/sdb1",
        "mounted": false
    },
    "facts": {
        "server.Mounts": {
            "/mnt/data": {
                "device": "/dev/sdb1",
                "type": "ext4",
                "options": ["rw", "relatime"]
            }
        }
    },
    "commands": [
        "umount /mnt/data"
    ]
}
