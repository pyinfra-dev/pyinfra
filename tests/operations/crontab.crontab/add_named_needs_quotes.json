{
    "args": ["backup /etc; rm -rf /"],
    "kwargs": {
        "cron_name": "evil job; $(whoami)"
    },
    "facts": {
        "crontab.Crontab": {
            "user=None": {}
        }
    },
    "commands": [
        "echo '# pyinfra-name=evil job; $(whoami)' >> _tempfile_",
        "echo '* * * * * backup /etc; rm -rf /' >> _tempfile_",
        "crontab  _tempfile_"
    ]
}
