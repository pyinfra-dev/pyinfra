{
    "args": ["http://myfile"],
    "kwargs": {
        "dest": "/home/myfile",
        "user": "newuser",
        "group": "newgroup"
    },
    "facts": {
        "server.Date": "datetime:2015-01-01T00:00:00",
        "files.File": {
            "path=/home/myfile": {
                "mode": 644,
                "user": "root",
                "group": "root"
            }
        }
    },
    "commands": [
        "chown newuser:newgroup /home/myfile"
    ]
}
